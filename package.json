{
  "name": "market-data-ts",
  "version": "0.1.0",
  "description": "Financial data scraper and analysis tool - TypeScript migration",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "market-data": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && tsc-esm-fix --ext .js && chmod +x dist/cli/index.js",
    "dev": "npm run build && node dist/cli/index.js",
    "dev:watch": "tsc --watch --noEmit",
    "start": "node dist/cli/index.js",
    "lint": "eslint src --ext .ts --cache",
    "lint:fix": "eslint src --ext .ts --cache --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check": "npm run type-check && npm run lint && npm run format:check",
    "fix": "npm run lint:fix && npm run format",
    "pretest": "npm run type-check",
    "prebuild": "npm run check"
  },
  "keywords": [
    "finance",
    "scraper",
    "bonds",
    "stocks",
    "data-analysis"
  ],
  "author": "Mars",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "csv-writer": "^1.6.0",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.3.1",
    "googleapis": "^118.0.0",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "yahoo-finance2": "^3.10.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-unicorn": "^50.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsc-esm-fix": "^3.1.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
