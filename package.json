{
  "name": "market-data",
  "version": "0.1.0",
  "description": "Financial data scraper and analysis tool with Google Sheets and Excel export",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint ts --ext .ts",
    "lint:fix": "eslint ts --ext .ts --fix",
    "format": "prettier --write 'ts/**/*.ts'",
    "format:check": "prettier --check 'ts/**/*.ts'",
    "type-check": "tsc --noEmit",
    "check": "npm run type-check && npm run lint && npm run format:check"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "dotenv": "^16.4.5",
    "google-auth-library": "^9.6.3",
    "googleapis": "^139.0.0",
    "xlsx": "^0.18.5",
    "yahoo-finance2": "^3.10.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
